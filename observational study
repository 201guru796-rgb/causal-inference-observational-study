import pandas as pd
from sklearn.linear_model import LogisticRegression
from sklearn.preprocessing import StandardScaler
from sklearn.pipeline import make_pipeline


def estimate_ate(df, treatment, outcome, covariates):
    """
    Estimate the Average Treatment Effect using a doubly robust estimator.

    Parameters
    ----------
    df : pandas.DataFrame
        Observational dataset.
    treatment : str
        Binary treatment column.
    outcome : str
        Continuous outcome column.
    covariates : list[str]
        Pre-treatment confounders.

    Returns
    -------
    float
        Estimated Average Treatment Effect.
    """

    data = df[[treatment, outcome] + covariates].dropna().copy()

    if data.empty:
        raise ValueError("No complete observations remain after removing missing data.")

    if set(data[treatment].unique()) != {0, 1}:
        raise ValueError("Treatment must be binary and encoded as 0 and 1.")

    X = data[covariates]
    A = data[treatment].astype(int).to_numpy()
    Y = data[outcome].astype(float).to_numpy()

    # Propensity-score model
    propensity_model = make_pipeline(
        StandardScaler(),
        LogisticRegression(max_iter=2000)
    )

    propensity_model.fit(X, A)
    e = propensity_model.predict_proba(X)[:, 1]

    # Prevent extreme inverse-probability weights.
    e = np.clip(e, 0.01, 0.99)

    # Outcome models
    treated = A == 1
    control = A == 0

    outcome_treated = make_pipeline(
        StandardScaler(),
        LogisticRegression(max_iter=2000)
    ) if False else None

    # Use linear regression for continuous outcomes.
    from sklearn.linear_model import LinearRegression

    model_treated = make_pipeline(
        StandardScaler(),
        LinearRegression()
    )
    model_control = make_pipeline(
        StandardScaler(),
        LinearRegression()
    )

    model_treated.fit(X[treated], Y[treated])
    model_control.fit(X[control], Y[control])

    mu1 = model_treated.predict(X)
    mu0 = model_control.predict(X)

    # Doubly robust estimator
    dr_treated = mu1 + (A * (Y - mu1) / e)
    dr_control = mu0 + ((1 - A) * (Y - mu0) / (1 - e))

    ate = np.mean(dr_treated - dr_control)

    return float(ate)


def validate_data(df, treatment, outcome, covariates):
    """Basic validation checks for the analysis dataset."""

    required = [treatment, outcome] + covariates
    missing_columns = [c for c in required if c not in df.columns]

    if missing_columns:
        raise ValueError(
            f"Missing required columns: {missing_columns}"
        )

    if df[treatment].isna().all():
        raise ValueError("Treatment contains no usable observations.")

    if df[outcome].isna().all():
        raise ValueError("Outcome contains no usable observations.")

